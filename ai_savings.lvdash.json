{
  "datasets": [
    {
      "name": "ds_usage_daily",
      "displayName": "Consumo diário por modelo + simulação",
      "queryLines": [
        "WITH scoped AS ( ",
        "  SELECT * FROM perdomo_demos_catalog.ai_savings.v_model_usage_daily ",
        "  WHERE (size(:param_workspace) = 0 OR array_contains(:param_workspace, workspace_id)) ",
        "), ",
        "base AS ( ",
        "  SELECT * FROM scoped ",
        "  WHERE event_date BETWEEN :date_range.min AND :date_range.max ",
        "    AND (size(:param_models) = 0 OR array_contains(:param_models, destination_model)) ",
        "), ",
        "sim_rate AS ( ",
        "  SELECT CAST(SUM(cost_usd) AS DOUBLE) / NULLIF(SUM(total_tokens), 0) AS rate",
        "  FROM scoped WHERE destination_model = :param_sim_model ",
        "), ",
        "daily AS ( ",
        "  SELECT event_date, SUM(total_tokens) AS day_tokens FROM base GROUP BY event_date ",
        ") ",
        "SELECT ",
        "  b.event_date, ",
        "  b.destination_model, ",
        "  CAST(SUM(b.cost_usd) AS DECIMAL(38,2)) AS cost_usd, ",
        "  SUM(b.total_tokens) AS total_tokens, ",
        "  CAST(MIN(d.day_tokens) * MIN(s.rate) AS DECIMAL(38,2)) AS sim_cost_usd ",
        "FROM base b ",
        "JOIN daily d ON b.event_date = d.event_date ",
        "CROSS JOIN sim_rate s ",
        "GROUP BY b.event_date, b.destination_model ",
        "ORDER BY b.event_date "
      ],
      "parameters": [
        {
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          },
          "displayName": "date_range"
        },
        {
          "keyword": "param_workspace",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": []
            }
          },
          "displayName": "param_workspace"
        },
        {
          "keyword": "param_models",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": []
            }
          },
          "displayName": "param_models"
        },
        {
          "keyword": "param_sim_model",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "claude-opus-4-8"
                }
              ]
            }
          },
          "displayName": "param_sim_model"
        }
      ]
    },
    {
      "name": "ds_kpis",
      "displayName": "KPIs: real, estimado, economia",
      "queryLines": [
        "WITH scoped AS ( ",
        "  SELECT * FROM perdomo_demos_catalog.ai_savings.v_model_usage_daily ",
        "  WHERE (size(:param_workspace) = 0 OR array_contains(:param_workspace, workspace_id)) ",
        "), ",
        "base AS ( ",
        "  SELECT * FROM scoped ",
        "  WHERE event_date BETWEEN :date_range.min AND :date_range.max ",
        "    AND (size(:param_models) = 0 OR array_contains(:param_models, destination_model)) ",
        "), ",
        "sim_rate AS ( ",
        "  SELECT CAST(SUM(cost_usd) AS DOUBLE) / NULLIF(SUM(total_tokens), 0) AS rate ",
        "  FROM scoped WHERE destination_model = :param_sim_model ",
        ") ",
        "SELECT ",
        "  CAST(SUM(base.cost_usd) AS DECIMAL(38,2)) AS real_cost, ",
        "  CAST(SUM(base.total_tokens) * MIN(sim_rate.rate) AS DECIMAL(38,2)) AS sim_cost, ",
        "  CAST(SUM(base.total_tokens) * MIN(sim_rate.rate) - SUM(base.cost_usd) AS DECIMAL(38,2)) AS savings ",
        "FROM base CROSS JOIN sim_rate "
      ],
      "parameters": [
        {
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          },
          "displayName": "date_range"
        },
        {
          "keyword": "param_workspace",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": []
            }
          },
          "displayName": "param_workspace"
        },
        {
          "keyword": "param_models",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": []
            }
          },
          "displayName": "param_models"
        },
        {
          "keyword": "param_sim_model",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "claude-opus-4-8"
                }
              ]
            }
          },
          "displayName": "param_sim_model"
        }
      ]
    },
    {
      "name": "ds_compare",
      "displayName": "Comparativo do período: real vs. modelo único",
      "queryLines": [
        "WITH scoped AS ( ",
        "  SELECT * FROM perdomo_demos_catalog.ai_savings.v_model_usage_daily ",
        "  WHERE (size(:param_workspace) = 0 OR array_contains(:param_workspace, workspace_id)) ",
        "), ",
        "base AS ( ",
        "  SELECT * FROM scoped ",
        "  WHERE event_date BETWEEN :date_range.min AND :date_range.max ",
        "    AND (size(:param_models) = 0 OR array_contains(:param_models, destination_model)) ",
        "), ",
        "totals AS (SELECT SUM(total_tokens) AS tt, SUM(cost_usd) AS rc FROM base), ",
        "rates AS ( ",
        "  SELECT destination_model, CAST(SUM(cost_usd) AS DOUBLE) / NULLIF(SUM(total_tokens), 0) AS rate",
        "  FROM scoped GROUP BY destination_model ",
        ") ",
        "SELECT '0 · Real (mix atual)' AS scenario, CAST((SELECT rc FROM totals) AS DECIMAL(38,2)) AS cost_usd ",
        "UNION ALL ",
        "SELECT concat('Só ', r.destination_model) AS scenario, ",
        "       CAST((SELECT tt FROM totals) * r.rate AS DECIMAL(38,2)) AS cost_usd ",
        "FROM rates r ",
        "WHERE array_contains(:param_compare_models, r.destination_model) ",
        "ORDER BY scenario "
      ],
      "parameters": [
        {
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          },
          "displayName": "date_range"
        },
        {
          "keyword": "param_workspace",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": []
            }
          },
          "displayName": "param_workspace"
        },
        {
          "keyword": "param_models",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": []
            }
          },
          "displayName": "param_models"
        },
        {
          "keyword": "param_compare_models",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": []
            }
          },
          "displayName": "param_compare_models"
        }
      ]
    },
    {
      "name": "ds_dim_models",
      "displayName": "Modelos disponíveis",
      "queryLines": [
        "SELECT DISTINCT destination_model ",
        "FROM perdomo_demos_catalog.ai_savings.v_model_usage_daily ",
        "WHERE destination_model IS NOT NULL ",
        "ORDER BY destination_model "
      ]
    },
    {
      "name": "ds_dim_workspaces",
      "displayName": "Workspaces disponíveis",
      "queryLines": [
        "SELECT DISTINCT workspace_id ",
        "FROM perdomo_demos_catalog.ai_savings.v_model_usage_daily ",
        "WHERE workspace_id IS NOT NULL ",
        "ORDER BY workspace_id "
      ]
    },
    {
      "name": "ds_harness",
      "displayName": "Consumo em dólares por harness",
      "queryLines": [
        "WITH scoped AS ( ",
        "  SELECT * FROM perdomo_demos_catalog.ai_savings.v_model_usage_daily ",
        "  WHERE (size(:param_workspace) = 0 OR array_contains(:param_workspace, workspace_id)) ",
        "), ",
        "base AS ( ",
        "  SELECT event_date, workspace_id, endpoint_name, destination_model, SUM(cost_usd) AS cost_usd ",
        "  FROM scoped ",
        "  WHERE event_date BETWEEN :date_range.min AND :date_range.max ",
        "    AND (size(:param_models) = 0 OR array_contains(:param_models, destination_model)) ",
        "  GROUP BY 1, 2, 3, 4 ",
        "), ",
        "harness AS ( ",
        "  SELECT DATE(event_time) AS event_date, CAST(workspace_id AS STRING) AS workspace_id, endpoint_name, ",
        "         LOWER(REGEXP_REPLACE(destination_model, '[ .]+', '-')) AS destination_model, ",
        "         CASE ",
        "           WHEN url LIKE '%/cursor/v1/chat/completions%' THEN 'Cursor' ",
        "           WHEN lower(user_agent) LIKE '%claude%' THEN 'Claude Code' ",
        "           WHEN lower(user_agent) LIKE '%gemini%' THEN 'Gemini CLI' ",
        "           WHEN lower(user_agent) LIKE '%codex%' THEN 'Codex CLI' ",
        "           WHEN lower(user_agent) LIKE '%opencode%' THEN 'OpenCode' ",
        "           WHEN lower(user_agent) LIKE 'pi/%' THEN 'Pi' ",
        "           WHEN lower(user_agent) LIKE '%copilot%' THEN 'Github Copilot' ",
        "           ELSE 'Outros / API direta' ",
        "         END AS harness, ",
        "         SUM(total_tokens) AS htok ",
        "  FROM system.ai_gateway.usage ",
        "  WHERE destination_model IS NOT NULL ",
        "    AND (invocation_metadata.source != 'AI_QUERY' OR invocation_metadata.source IS NULL) ",
        "    AND (service_type != 'MCP_SERVICE' OR service_type IS NULL) ",
        "  GROUP BY 1, 2, 3, 4, 5 ",
        "), ",
        "grp AS ( ",
        "  SELECT event_date, workspace_id, endpoint_name, destination_model, SUM(htok) AS mtok ",
        "  FROM harness GROUP BY 1, 2, 3, 4 ",
        ") ",
        "SELECT h.harness, ",
        "       CAST(SUM(CAST(base.cost_usd AS DOUBLE) * h.htok / NULLIF(g.mtok, 0)) AS DECIMAL(38,2)) AS cost_usd ",
        "FROM base ",
        "JOIN harness h ON base.event_date = h.event_date AND base.workspace_id = h.workspace_id ",
        "  AND base.endpoint_name = h.endpoint_name AND base.destination_model = h.destination_model ",
        "JOIN grp g ON base.event_date = g.event_date AND base.workspace_id = g.workspace_id ",
        "  AND base.endpoint_name = g.endpoint_name AND base.destination_model = g.destination_model ",
        "GROUP BY h.harness ",
        "ORDER BY cost_usd DESC "
      ],
      "parameters": [
        {
          "keyword": "date_range",
          "displayName": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        },
        {
          "keyword": "param_workspace",
          "displayName": "param_workspace",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": []
            }
          }
        },
        {
          "keyword": "param_models",
          "displayName": "param_models",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": []
            }
          }
        }
      ]
    }
  ],
